{
  "name": "Houston Foundation Issues Auto-Poster",
  "description": "Automated workflow that searches for Houston foundation issues, extracts content with Firecrawl, generates social media posts with Claude, and posts to Twitter, Reddit, Facebook, and Instagram",
  "nodes": [
    {
      "parameters": {
        "trigger": "every",
        "unit": "day",
        "value": 1
      },
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "resource": "search",
        "searchEngineType": "google",
        "query": "Houston foundation issues Bammel North sinkhole 2024 2025",
        "limit": 5
      },
      "name": "Search Web",
      "type": "n8n-nodes-base.google",
      "typeVersion": 1,
      "position": [500, 300],
      "credentials": {
        "googleApi": "Google API"
      }
    },
    {
      "parameters": {
        "operation": "get",
        "url": "={{ $node['Search Web'].json.results[0].link }}",
        "responseFormat": "json"
      },
      "name": "Firecrawl Extract Content",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [750, 300],
      "credentials": {
        "httpBasicAuth": "Firecrawl API"
      }
    },
    {
      "parameters": {
        "model": "claude-opus-4-1",
        "messages": [
          {
            "role": "user",
            "content": "Based on this content about Houston foundation issues: {{ $node['Firecrawl Extract Content'].json.content }}\n\nGenerate 4 engaging social media posts (one for each platform: Twitter/X, Reddit, Facebook, Instagram). Make them informative, compelling, and platform-appropriate. Format as JSON with keys: twitter, reddit, facebook, instagram. Keep Twitter under 280 characters. Add relevant hashtags for each platform."
          }
        ]
      },
      "name": "Generate Social Posts",
      "type": "n8n-nodes-base.anthropic",
      "typeVersion": 1,
      "position": [1000, 300],
      "credentials": {
        "anthropicApi": "Anthropic API"
      }
    },
    {
      "parameters": {
        "operation": "createTweet",
        "status": "={{ JSON.parse($node['Generate Social Posts'].json.content[0].text).twitter }}"
      },
      "name": "Post to Twitter",
      "type": "n8n-nodes-base.twitter",
      "typeVersion": 2,
      "position": [1250, 100],
      "credentials": {
        "twitterOAuth2Api": "Twitter API"
      }
    },
    {
      "parameters": {
        "operation": "createPost",
        "subreddit": "houston",
        "title": "Houston Foundation Issues Update",
        "text": "={{ JSON.parse($node['Generate Social Posts'].json.content[0].text).reddit }}"
      },
      "name": "Post to Reddit",
      "type": "n8n-nodes-base.reddit",
      "typeVersion": 1,
      "position": [1250, 250],
      "credentials": {
        "redditOAuth2Api": "Reddit API"
      }
    },
    {
      "parameters": {
        "operation": "createPost",
        "message": "={{ JSON.parse($node['Generate Social Posts'].json.content[0].text).facebook }}",
        "pageAccessToken": "{{ $env.FACEBOOK_PAGE_ACCESS_TOKEN }}"
      },
      "name": "Post to Facebook",
      "type": "n8n-nodes-base.facebook",
      "typeVersion": 1,
      "position": [1250, 400],
      "credentials": {
        "facebookOAuth2Api": "Facebook API"
      }
    },
    {
      "parameters": {
        "operation": "createPost",
        "caption": "={{ JSON.parse($node['Generate Social Posts'].json.content[0].text).instagram }}",
        "accessToken": "{{ $env.INSTAGRAM_ACCESS_TOKEN }}"
      },
      "name": "Post to Instagram",
      "type": "n8n-nodes-base.instagram",
      "typeVersion": 1,
      "position": [1250, 550],
      "credentials": {
        "instagramOAuth2Api": "Instagram API"
      }
    },
    {
      "parameters": {
        "operation": "send",
        "message": "✅ Daily Houston foundation issues post published to all platforms:\n- Twitter\n- Reddit\n- Facebook\n- Instagram\n\nContent: {{ JSON.parse($node['Generate Social Posts'].json.content[0].text) }}"
      },
      "name": "Notify Success",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [1500, 300],
      "credentials": {
        "slackApi": "Slack API"
      }
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Search Web",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Search Web": {
      "main": [
        [
          {
            "node": "Firecrawl Extract Content",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Firecrawl Extract Content": {
      "main": [
        [
          {
            "node": "Generate Social Posts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Social Posts": {
      "main": [
        [
          {
            "node": "Post to Twitter",
            "type": "main",
            "index": 0
          },
          {
            "node": "Post to Reddit",
            "type": "main",
            "index": 0
          },
          {
            "node": "Post to Facebook",
            "type": "main",
            "index": 0
          },
          {
            "node": "Post to Instagram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Post to Twitter": {
      "main": [
        [
          {
            "node": "Notify Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
