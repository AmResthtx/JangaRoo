# n8n Configuration (.env)
# Copy this file to .env and fill in your actual values
# Then uncomment the relevant variables in docker-compose.yml

# ===== Basic Configuration =====
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=http
TZ=America/Chicago

# ===== Security (for HTTPS/Production) =====
# N8N_PROTOCOL=https
# N8N_SECURE_COOKIE=true
# WEBHOOK_TUNNEL_URL=https://your-domain.com/

# ===== Database Configuration =====
# Leave commented for SQLite (file-based)
# Uncomment for PostgreSQL:

# DB_TYPE=postgresdb
# DB_POSTGRESDB_HOST=postgres
# DB_POSTGRESDB_PORT=5432
# DB_POSTGRESDB_DATABASE=n8n
# DB_POSTGRESDB_USER=n8n
# DB_POSTGRESDB_PASSWORD=change_this_to_secure_password

# ===== API Keys (Add your credentials here) =====
# These are for reference - configure in n8n UI instead

# Anthropic/Claude
# ANTHROPIC_API_KEY=your_anthropic_api_key

# Firecrawl
# FIRECRAWL_API_KEY=your_firecrawl_api_key

# Google Search
# GOOGLE_SEARCH_API_KEY=your_google_search_api_key

# Social Media - Configure in n8n Credentials UI
# TWITTER_API_KEY=your_twitter_api_key
# REDDIT_CLIENT_ID=your_reddit_client_id
# FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_token
# INSTAGRAM_ACCESS_TOKEN=your_instagram_token

# ===== Optional Settings =====
# Node Environment
# NODE_ENV=production

# JWT Secret (generate a random string)
# JWT_SECRET=your_random_jwt_secret

# Timezone Options:
# TZ=America/New_York
# TZ=America/Los_Angeles
# TZ=America/Denver
# TZ=America/Chicago
# TZ=Europe/London
# TZ=Europe/Paris
# TZ=Asia/Tokyo
# TZ=Australia/Sydney
